# MyDaily Environment Variables
# Copy this file to .env and customise as needed.
# Docker Compose automatically loads .env from the project root.

# ── Authentication ──────────────────────────────────────────────────
# Password required to log in to MyDaily.
# Leave empty ONLY for local quick-start; production MUST set a strong password.
# If you leave it empty, you must also set MYDAILY_AUTH_DISABLED=true to make the
# "auth disabled" intent explicit (otherwise the backend refuses to start).
MYDAILY_PASSWORD=

# Secret used to sign auth tokens.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# The start.sh script will auto-generate one for you on first run if left empty.
MYDAILY_SECRET_KEY=

# Token time-to-live in seconds (default: 30 days = 2592000).
# MYDAILY_TOKEN_TTL_SECONDS=2592000

# Explicitly disable auth (only effective when MYDAILY_PASSWORD is empty).
# Set to true ONLY for trusted local environments.
# MYDAILY_AUTH_DISABLED=false

# ── Networking ──────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# MYDAILY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# ── Storage ─────────────────────────────────────────────────────────
# Directory for the SQLite database file. Defaults: /app/data in Docker,
# or ./data in local development.
# MYDAILY_DATA_DIR=/path/to/data

# ── Runtime ────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
