# MyDaily Environment Variables
# Copy this file to .env and customise as needed.
# Docker Compose automatically loads .env from the project root.

# ── Authentication ──────────────────────────────────────────────────
# Password required to log in to MyDaily (default is intentionally weak — change this!)
MYDAILY_PASSWORD=asd123123123

# Secret used to sign auth tokens. Set to a long random string in production.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
MYDAILY_SECRET_KEY=mydaily-default-secret-key

# ── Runtime ────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
